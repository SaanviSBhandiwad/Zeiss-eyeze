# Copy to server/.env. Every service is optional: leave a block empty and the app falls back
# (in-memory demo data, browser speech, local audio folder). On Render, set these as environment variables.

PORT=4000
# Browser origins allowed to call the API (comma-separated). On Render: your static site URL.
CLIENT_ORIGIN=http://localhost:5173

# --- Supabase (phase 1). Leave empty for demo mode with mock patients. ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Never put this in the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sarvam AI (phase 2). Leave empty to use the browser's own speech features. ---
SARVAM_API_KEY=
# Check https://docs.sarvam.ai for current model names before changing these.
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=ishita
SARVAM_TTS_PACE=0.95
SARVAM_TRANSLATE_MODEL=mayura:v1

# --- Amazon S3 (phase 2). Use the Mumbai region. Leave S3_BUCKET empty to store audio in server/.storage. ---
AWS_REGION=ap-south-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Demo mode only ---
# Signs demo tokens and local audio links. Set a long random value so sessions survive restarts.
DEMO_SECRET=
DEMO_OPTOMETRIST_EMAIL=anjali.rao@eyeze.in
DEMO_OPTOMETRIST_PASSWORD=demo-password
