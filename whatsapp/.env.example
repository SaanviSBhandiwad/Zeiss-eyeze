# Copy to .env and fill in. Never commit .env.
PORT=3000

# From console.twilio.com -> Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# Twilio WhatsApp sandbox number (shown on the sandbox page)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Set to true once ngrok is running, so only real Twilio requests are accepted.
VALIDATE_TWILIO=false
# Your current ngrok https URL (no trailing slash). Needed only if VALIDATE_TWILIO=true.
PUBLIC_URL=https://xxxx.ngrok-free.app

# Simple key for the optometrist API (header: x-api-key)
OPTOMETRIST_API_KEY=change-me

# Bridge to the Eyeze app (optional). Finished WhatsApp profiles go to the same optometrist queue,
# and replies from the Eyeze portal come back here and are sent on WhatsApp.
# Set the same WHATSAPP_BRIDGE_KEY on the eyeze-api service.
EYEZE_API_URL=https://eyeze-api.onrender.com
WHATSAPP_BRIDGE_KEY=change-me-long-random

# Google Cloud speech (voice notes) and text-to-speech: path to a service-account key file.
# Never commit the key. On Render, add it as a Secret File and point this at /etc/secrets/<name>.json
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
